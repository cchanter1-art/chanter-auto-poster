<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Modules — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body class="platform-command-center">
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>
    <main class="command-main">
      <%- include('_platform-page-header', {
        eyebrow: 'Capability map',
        title: 'Modules',
        subtitle: 'AutoPoster is the customer module. Everything else is listed for internal ownership only.',
        action: commandCenter.modules.find(function (module) { return module.action.enabled; }).action
      }) %>

      <section class="command-section" aria-labelledby="customer-modules-title">
        <div class="command-section-heading">
          <div>
            <span class="command-eyebrow">Customer</span>
            <h2 id="customer-modules-title">Available modules</h2>
          </div>
        </div>
        <div class="module-grid command-module-grid" data-testid="customer-modules">
          <% commandCenter.modules.filter(function (module) { return module.surface === 'customer'; }).forEach(function (module) { %>
            <article class="module-card command-module-card" data-module="<%= module.id %>" data-surface="customer">
              <div class="module-card-head">
                <div class="module-name"><%= module.name %></div>
                <span class="chip <%= module.chip %>"><%= module.status %></span>
              </div>
              <p class="module-desc"><%= module.capability %></p>
              <div class="module-owner">Owner: <%= module.owner %></div>
              <a class="command-action" href="<%= module.action.href %>"><%= module.action.label %></a>
            </article>
          <% }); %>
        </div>
      </section>

      <section class="command-section" aria-labelledby="internal-modules-title">
        <div class="command-section-heading">
          <div>
            <span class="command-eyebrow">Internal</span>
            <h2 id="internal-modules-title">Ownership only</h2>
          </div>
        </div>
        <p class="command-section-note">Controls remain behind Operator. This surface exposes no internal action.</p>
        <div class="module-grid command-module-grid" data-testid="internal-modules">
          <% commandCenter.modules.filter(function (module) { return module.surface === 'internal'; }).forEach(function (module) { %>
            <article class="module-card command-module-card module-card-internal" data-module="<%= module.id %>" data-surface="internal">
              <div class="module-card-head">
                <div class="module-name"><%= module.name %></div>
                <span class="chip <%= module.chip %>"><%= module.status %></span>
              </div>
              <p class="module-desc"><%= module.capability %></p>
              <div class="module-owner">Owner: <%= module.owner %></div>
              <span class="command-action command-action-disabled" aria-disabled="true" title="<%= module.action.reason %>"><%= module.action.label %></span>
            </article>
          <% }); %>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
