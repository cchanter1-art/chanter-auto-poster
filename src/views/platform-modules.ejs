<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Modules — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body>
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>

    <div class="breadcrumb"><a href="/platform">Platform</a> / Modules</div>
    <h1 class="page-title">Modules</h1>
    <p class="page-subtitle">
      Every module declares who owns it.
    </p>

    <h2 class="section-title">Customer modules</h2>
    <div class="module-grid" data-testid="customer-modules">
      <% customerModules.forEach(function (module) { %>
        <a class="module-card" href="<%= module.href %>" data-module="<%= module.id %>" data-surface="customer">
          <div class="module-card-head">
            <div class="module-name"><%= module.name %></div>
            <span class="chip chip-ready">Active</span>
          </div>
          <div class="module-desc"><%= module.summary %></div>
          <div class="module-owner">Owner: <%= module.owner %></div>
        </a>
      <% }); %>
    </div>

    <h2 class="section-title">Internal modules</h2>
    <p class="section-note">
      Operated behind Operator. Listed for transparency only — no control over them exists on this surface.
    </p>
    <div class="module-grid" data-testid="internal-modules">
      <% internalModules.forEach(function (module) { %>
        <div class="module-card module-card-internal" data-module="<%= module.id %>" data-surface="internal">
          <div class="module-card-head">
            <div class="module-name"><%= module.name %></div>
            <span class="chip chip-neutral">Internal</span>
          </div>
          <div class="module-desc"><%= module.summary %></div>
          <div class="module-owner">Owner: <%= module.owner %></div>
        </div>
      <% }); %>
    </div>

    <p class="footer-note">
      Repository control, commit, push, deployment and worker administration remain internal only.
    </p>
  </div>
</body>
</html>
