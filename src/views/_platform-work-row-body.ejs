<%
// The inside of one Platform work row. Shared by the linked and unlinked
// wrappers in _platform-work-row.ejs so the two render identically apart from
// being clickable — an internal row must not look like a downgraded version of
// a customer row, only like one you cannot open.
//
// The module name comes from the canonical item (stamped by
// platformWorkProviders from the registry), never from a per-module conditional
// in a shell surface.
%>
<div>
  <div><%= item.title %></div>
  <div class="meta"><%= item.moduleName %><% if (metaText) { %> &middot; <%= metaText %><% } %></div>
  <% if (item.updatedLabel || item.evidenceState) { %>
    <div class="work-row-facts">
      <span>Updated: <%= item.updatedLabel || 'Unavailable' %></span>
      <span>Evidence: <%= item.evidenceState || 'Not measured' %></span>
    </div>
  <% } %>
</div>
<div class="counts"><%= countsText %></div>
<span class="chip <%= view.chip %>"><%= chipLabel %></span>
<% if (item.nextAction) { %>
  <span class="work-row-action<%= item.nextAction.enabled ? '' : ' work-row-action-disabled' %>"><%= item.nextAction.label %></span>
<% } %>
