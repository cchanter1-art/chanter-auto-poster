<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>System health — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body>
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>

    <div class="breadcrumb"><a href="/platform">Platform</a> / System health</div>
    <h1 class="page-title">System health</h1>
    <p class="page-subtitle">
      One measured storage signal and one fixed approval guarantee. Anything unmeasured is reported as unknown.
    </p>

    <div class="health-grid" data-testid="health-grid">
      <div class="panel health-card" data-health="storage">
        <div class="health-head">
          <div class="health-name">Storage</div>
          <span class="chip <%= health.storage.reachable === true ? 'chip-ready' : (health.storage.reachable === false ? 'chip-failed' : 'chip-neutral') %>">
            <%= health.storage.reachable === true ? 'Reachable' : (health.storage.reachable === false ? 'Unreachable' : 'Unknown') %>
          </span>
        </div>
        <div class="health-detail">Provider: <%= health.storage.provider %> &middot; mode: <%= health.storage.mode %></div>
      </div>

      <div class="panel health-card" data-health="approval">
        <div class="health-head">
          <div class="health-name">Approval</div>
          <span class="chip chip-ready">Approval required</span>
        </div>
        <div class="health-detail">Nothing is scheduled without human approval.</div>
      </div>

      <div class="panel health-card" data-health="modules">
        <div class="health-head">
          <div class="health-name">Modules</div>
          <span class="chip chip-neutral"><%= customerModuleCount %> + <%= internalModuleCount %></span>
        </div>
        <div class="health-detail"><%= customerModuleCount %> active for you, <%= internalModuleCount %> internal.</div>
      </div>

      <div class="panel health-card" data-health="work">
        <div class="health-head">
          <div class="health-name">Work</div>
          <span class="chip <%= workError ? 'chip-failed' : 'chip-neutral' %>"><%= workError ? 'Unknown' : workSummary.total %></span>
        </div>
        <div class="health-detail">
          <% if (workError) { %>
            Work could not be read.
          <% } else { %>
            <%= workSummary.running %> running, <%= workSummary.awaitingApproval %> waiting for approval, <%= workSummary.failed %> failed.
          <% } %>
        </div>
        <% if (workError) { %><div class="health-detail-en"><%= workError %></div><% } %>
        <%
        // A partial read is reported as a partial read. The count above stays
        // truthful about what was read; this line names what was not, so a
        // module outage can never hide behind a healthy-looking total.
        const degradedProviders = locals.workDegraded || [];
        %>
        <% if (!workError && degradedProviders.length > 0) { %>
          <div class="health-detail-en" data-testid="health-work-degraded">
            Partial: <% degradedProviders.forEach(function (entry, index) { %><%= index > 0 ? ', ' : '' %><%= entry.moduleName %><% }); %> could not be read.
          </div>
        <% } %>
      </div>

      <div class="panel health-card" data-health="providers">
        <div class="health-head">
          <div class="health-name">Work sources</div>
          <span class="chip <%= (locals.workDegraded || []).length > 0 || workError ? 'chip-attention' : 'chip-neutral' %>"><%= locals.workProviderCount || 0 %></span>
        </div>
        <div class="health-detail">
          <%= (locals.workProviderCount || 0) - (locals.workDegraded || []).length %> of <%= locals.workProviderCount || 0 %> registered modules answered.
        </div>
      </div>
    </div>

    <p class="section-note" style="margin-top:18px" data-testid="health-observed-at">
      Observed at <%= health.observedAt %>
    </p>

    <p class="footer-note">
      Runtime readiness, workers and deployment status are tracked internally in Operator and are not claimed here.
    </p>
  </div>
</body>
</html>
