<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>System Health — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body class="platform-command-center">
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>
    <main class="command-main">
      <%- include('_platform-page-header', {
        eyebrow: 'Measured readiness',
        title: 'System Health',
        subtitle: 'Available signals are explicit. Unmeasured state stays unavailable.',
        action: { label: 'Inspect', href: '/platform/work', enabled: true, reason: '' }
      }) %>

      <section class="health-summary command-section" data-testid="health-summary">
        <div>
          <span class="command-eyebrow">Overall</span>
          <h2><%= commandCenter.systemState.label %></h2>
          <p><%= commandCenter.systemState.reason %></p>
        </div>
        <span class="chip <%= commandCenter.systemState.chip %>"><%= commandCenter.systemState.label %></span>
      </section>

      <div class="health-grid command-health-grid" data-testid="health-grid">
        <article class="panel health-card" data-health="application">
          <div class="health-head">
            <div class="health-name">Application</div>
            <span class="chip chip-ready"><%= commandCenter.health.application.status %></span>
          </div>
          <div class="health-detail">This authenticated Platform response is available.</div>
        </article>

        <article class="panel health-card" data-health="runtime-control">
          <div class="health-head">
            <div class="health-name">Runtime control</div>
            <span class="chip <%= commandCenter.health.runtimeControl.configured ? 'chip-ready' : 'chip-neutral' %>"><%= commandCenter.health.runtimeControl.status %></span>
          </div>
          <div class="health-detail">Authenticated control authority is <%= commandCenter.health.runtimeControl.configured ? 'configured' : 'unavailable' %>.</div>
        </article>

        <article class="panel health-card" data-health="storage">
          <div class="health-head">
            <div class="health-name">Storage</div>
            <span class="chip <%= commandCenter.health.storage.reachable === true ? 'chip-ready' : (commandCenter.health.storage.reachable === false ? 'chip-failed' : 'chip-neutral') %>">
              <%= commandCenter.health.storage.reachable === true ? 'Reachable' : (commandCenter.health.storage.reachable === false ? 'Unreachable' : 'Unavailable') %>
            </span>
          </div>
          <div class="health-detail">Provider: <%= commandCenter.health.storage.provider %> · mode: <%= commandCenter.health.storage.mode %></div>
        </article>

        <article class="panel health-card" data-health="scheduler">
          <div class="health-head">
            <div class="health-name">Scheduler</div>
            <span class="chip chip-neutral"><%= commandCenter.health.scheduler.inMemoryTimer ? 'In process' : 'External only' %></span>
          </div>
          <div class="health-detail">Mode: <%= commandCenter.health.scheduler.mode %> · last tick: <%= commandCenter.health.scheduler.lastTickAt || 'Unavailable' %></div>
        </article>

        <article class="panel health-card" data-health="canonical-execution">
          <div class="health-head">
            <div class="health-name">Canonical execution</div>
            <span class="chip <%= commandCenter.health.canonicalExecution.enabled ? 'chip-attention' : 'chip-neutral' %>"><%= commandCenter.health.canonicalExecution.status %></span>
          </div>
          <div class="health-detail">Default Composer path: <%= commandCenter.health.canonicalExecution.defaultComposerPath ? 'Active' : 'Inactive' %></div>
        </article>

        <article class="panel health-card" data-health="connections">
          <div class="health-head">
            <div class="health-name">Connected channels</div>
            <span class="chip <%= commandCenter.health.connections.error ? 'chip-neutral' : 'chip-ready' %>"><%= commandCenter.health.connections.error ? 'Unavailable' : commandCenter.health.connections.connectedCount %></span>
          </div>
          <div class="health-detail">
            <% if (commandCenter.health.connections.error) { %>
              <%= commandCenter.health.connections.error %>
            <% } else { %>
              <%= commandCenter.health.connections.publishingReadyCount %> publishing-ready.
            <% } %>
          </div>
        </article>

        <article class="panel health-card" data-health="providers">
          <div class="health-head">
            <div class="health-name">Providers</div>
            <span class="chip chip-neutral"><%= commandCenter.health.providers.filter(function (provider) { return provider.available; }).length %> available</span>
          </div>
          <ul class="health-status-list">
            <% commandCenter.health.providers.forEach(function (provider) { %>
              <li><span><%= provider.name %></span><strong><%= provider.status %></strong></li>
            <% }); %>
          </ul>
        </article>

        <article class="panel health-card" data-health="work">
          <div class="health-head">
            <div class="health-name">Work sources</div>
            <span class="chip <%= workError ? 'chip-failed' : ((locals.workDegraded || []).length ? 'chip-attention' : 'chip-ready') %>">
              <%= workError ? 'Unavailable' : `${workProviderCount - (locals.workDegraded || []).length} of ${workProviderCount}` %>
            </span>
          </div>
          <div class="health-detail"<%- !workError && (locals.workDegraded || []).length ? ' data-testid="health-work-degraded"' : '' %>>
            <% if (workError) { %>
              <%= workError %>
            <% } else if ((locals.workDegraded || []).length) { %>
              Partial read. <%= workProviderCount - (locals.workDegraded || []).length %> of <%= workProviderCount %> registered work sources answered. <%= (locals.workDegraded || []).map(function (entry) { return entry.moduleName; }).join(', ') %> unavailable.
            <% } else { %>
              <%= workProviderCount %> of <%= workProviderCount %> registered work sources answered.
            <% } %>
          </div>
        </article>

        <article class="panel health-card" data-health="approval">
          <div class="health-head">
            <div class="health-name">Approval authority</div>
            <span class="chip chip-ready">Required</span>
          </div>
          <div class="health-detail">Approval stays inside the owning customer module.</div>
        </article>
      </div>

      <p class="section-note health-observed" data-testid="health-observed-at">Observed at <%= commandCenter.health.observedAt || 'Unavailable' %></p>
      <p class="footer-note">No worker, deployment, provider, or internal Operator control is exposed here.</p>
    </main>
  </div>
</body>
</html>
