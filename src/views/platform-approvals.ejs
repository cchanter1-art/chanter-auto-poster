<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Approvals — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body>
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>

    <div class="breadcrumb"><a href="/platform">Platform</a> / Approvals</div>
    <h1 class="page-title">Approvals</h1>
    <p class="page-subtitle">
      Everything waiting on a person. Approval itself is granted inside the module, never from this list.
    </p>

    <% if (workError) { %>
      <div class="notice notice-error" data-testid="work-error">Approvals are unavailable right now. &middot; <%= workError %></div>
    <% } %>
    <%- include('_platform-degraded', { workError: workError, workDegraded: locals.workDegraded }) %>

    <% if (items.length === 0) { %>
      <div class="empty-state" data-testid="approvals-empty">
        <div>Nothing is waiting for approval.</div>
      </div>
    <% } else { %>
      <div class="batch-list" data-testid="approvals-list">
        <% items.forEach(function (item) { %>
          <%- include('_platform-work-row', {
            item: item,
            view: platformStatus.presentation(item.state),
            metaText: item.stateReason,
            countsText: `${item.counts.awaiting} to review`,
            // Internal work is listed so the count is honest, but it is never
            // offered as something to open: its approver is not this customer.
            chipLabel: item.actionable ? 'Open to review' : 'Internal approval'
          }) %>
        <% }); %>
      </div>
    <% } %>

    <p class="footer-note">
      Nothing is scheduled until a human accepts each item inside the module.
    </p>
  </div>
</body>
</html>
