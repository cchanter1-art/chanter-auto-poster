<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Approvals — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body class="platform-command-center">
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>
    <main class="command-main">
      <%- include('_platform-page-header', {
        eyebrow: 'Human authority',
        title: 'Approvals',
        subtitle: 'Approve is the third stage. The decision context for every waiting item is visible here; approval itself remains inside the owning module.',
        action: { label: 'Inspect', href: '/platform/work', enabled: true, reason: '' }
      }) %>

      <% if (workError) { %>
        <div class="notice notice-error" data-testid="work-error">Approvals are unavailable. <%= workError %></div>
      <% } %>
      <%- include('_platform-degraded', { workError: workError, workDegraded: locals.workDegraded }) %>

      <% if (items.length === 0) { %>
        <div class="command-section command-empty command-empty-surface" data-testid="approvals-empty">
          <strong>Nothing is waiting for approval.</strong>
          <p>Prepared work arrives here once it is ready for review. Nothing publishes until a person approves it.</p>
        </div>
      <% } else { %>
        <div class="decision-grid" data-testid="approvals-list">
          <% items.forEach(function (item) { %>
            <article class="decision-card" data-work="<%= item.workId %>" data-surface="<%= item.surface %>">
              <div class="decision-card-head">
                <div>
                  <span class="command-eyebrow"><%= item.moduleName %></span>
                  <h2><%= item.title %></h2>
                </div>
                <span class="chip chip-attention"><%= item.actionable ? 'Customer decision' : 'Internal decision' %></span>
              </div>
              <dl class="decision-fields">
                <div><dt>Requested action</dt><dd>Review prepared work</dd></div>
                <div><dt>Scope</dt><dd><%= item.counts.awaiting %> waiting of <%= item.counts.total %> items</dd></div>
                <div><dt>Risk</dt><dd>Not measured</dd></div>
                <div><dt>Reversibility</dt><dd>Unavailable</dd></div>
                <div><dt>Evidence</dt><dd><%= item.evidenceState %></dd></div>
              </dl>
              <p class="decision-reason"><%= item.stateReason %></p>
              <% if (item.nextAction.enabled) { %>
                <a class="command-action" href="<%= item.nextAction.href %>">Open</a>
              <% } else { %>
                <span class="command-action command-action-disabled" aria-disabled="true" title="<%= item.nextAction.reason %>">Inspect</span>
              <% } %>
            </article>
          <% }); %>
        </div>
      <% } %>
      <p class="footer-note">No approval, scheduling, upload, or publication action exists on this page.</p>
    </main>
  </div>
</body>
</html>
