<%
// Canonical CHANTER Platform navigation. Every Platform page includes this and
// passes `active` (one of: overview, modules, work, approvals, evidence,
// health, or '' for a page nested under a module). One list, one order — this
// is the only place the top-level information architecture is declared.
const platformNavItems = [
  { id: 'overview',  href: '/platform',            label: 'Επισκόπηση', labelEn: 'Overview' },
  { id: 'modules',   href: '/platform/modules',    label: 'Ενότητες',   labelEn: 'Modules' },
  { id: 'work',      href: '/platform/work',       label: 'Εργασίες',   labelEn: 'Work' },
  { id: 'approvals', href: '/platform/approvals',  label: 'Εγκρίσεις',  labelEn: 'Approvals' },
  { id: 'evidence',  href: '/platform/evidence',   label: 'Τεκμήρια',   labelEn: 'Evidence' },
  { id: 'health',    href: '/platform/health',     label: 'Κατάσταση',  labelEn: 'System health' }
];
%>
<header class="platform-header">
  <div class="brand">
    <span class="wordmark">CHANTER</span>
    <span class="product">Platform</span>
  </div>
  <nav class="header-nav">
    <a href="/private/autoposter">Κλασική κονσόλα</a>
    <form method="post" action="/logout" style="display:inline">
      <button type="submit" class="btn btn-quiet" style="padding:0;font-size:13.5px">Αποσύνδεση</button>
    </form>
  </nav>
</header>

<nav class="platform-nav" aria-label="CHANTER Platform">
  <% for (const item of platformNavItems) { %>
    <a
      class="platform-nav-link<%= active === item.id ? ' platform-nav-link-active' : '' %>"
      href="<%= item.href %>"
      data-nav="<%= item.id %>"
      <%- active === item.id ? 'aria-current="page"' : '' %>
    ><%= item.label %> <span class="platform-nav-en"><%= item.labelEn %></span></a>
  <% } %>
</nav>
