<%
// Canonical CHANTER Platform navigation. Every Platform page includes this and
// passes `active` (one of: overview, modules, work, approvals, evidence,
// health, or '' for a page nested under a module). One list, one order — this
// is the only place the top-level information architecture is declared.
//
// Shell and customer copy are English-only (worldwide-first). Operational
// surfaces outside the canonical customer path keep their existing copy.
// 'compose' is the ONE entry for creating and scheduling content. There is no
// second posting entry: one account and many accounts are the same workflow.
const platformNavItems = [
  { id: 'overview',  href: '/platform',           label: 'Overview' },
  { id: 'compose',   href: '/platform/compose',   label: 'Compose' },
  { id: 'modules',   href: '/platform/modules',   label: 'Modules' },
  { id: 'work',      href: '/platform/work',      label: 'Work' },
  { id: 'approvals', href: '/platform/approvals', label: 'Approvals' },
  { id: 'evidence',  href: '/platform/evidence',  label: 'Evidence' },
  { id: 'health',    href: '/platform/health',    label: 'System health' }
];
const customerNavItems = [
  { id: 'queue',    href: '/private/autoposter#queue',    label: 'Queue' },
  { id: 'accounts', href: '/private/autoposter/accounts', label: 'Accounts' },
  { id: 'activity', href: '/private/autoposter#activity', label: 'Activity' }
];
const customerSurface = active === 'compose' || active === 'accounts';
const navItems = customerSurface ? customerNavItems : platformNavItems;
%>
<header class="platform-header">
  <a class="brand" href="<%= customerSurface ? '/platform/compose' : '/platform' %>" aria-label="CHANTER <%= customerSurface ? 'AutoPoster' : 'Platform' %>">
    <span class="wordmark">CHANTER</span>
    <span class="product"><%= customerSurface ? 'AutoPoster' : 'Platform' %></span>
  </a>
  <nav class="header-nav">
    <% if (!customerSurface) { %><a href="/private/autoposter">Classic console</a><% } %>
    <form method="post" action="/logout" style="display:inline">
      <button type="submit" class="btn btn-quiet" style="padding:0;font-size:13.5px">Sign out</button>
    </form>
  </nav>
</header>

<nav class="platform-nav<%= customerSurface ? ' customer-nav' : '' %>" aria-label="<%= customerSurface ? 'AutoPoster' : 'CHANTER Platform' %>">
  <% for (const item of navItems) { %>
    <a
      class="platform-nav-link<%= active === item.id ? ' platform-nav-link-active' : '' %>"
      href="<%= item.href %>"
      data-nav="<%= item.id %>"
      <%- active === item.id ? 'aria-current="page"' : '' %>
    ><%= item.label %></a>
  <% } %>
</nav>
