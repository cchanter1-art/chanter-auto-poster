<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Evidence — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body>
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>

    <div class="breadcrumb"><a href="/platform">Platform</a> / Evidence</div>
    <h1 class="page-title">Evidence</h1>
    <p class="page-subtitle">
      For every unit of work: what was prepared, what failed, what was approved, and where to inspect it.
    </p>

    <% if (workError) { %>
      <div class="notice notice-error" data-testid="work-error">Evidence is unavailable right now. &middot; <%= workError %></div>
    <% } %>

    <% if (items.length === 0) { %>
      <div class="empty-state" data-testid="evidence-empty">
        <div>No evidence records yet.</div>
      </div>
    <% } else { %>
      <div class="batch-list" data-testid="evidence-list">
        <% items.forEach(function (item) { %>
          <% const view = platformStatus.presentation(item.state); %>
          <a class="batch-row" href="<%= item.href %>" data-work="<%= item.workId %>" data-state="<%= item.state %>">
            <div>
              <div><%= item.title %></div>
              <div class="meta">
                <%= item.moduleId === 'autoposter' ? 'AutoPoster' : item.moduleId %>
                <% if (item.createdAt) { %>&middot; <%= item.createdAt %><% } %>
              </div>
            </div>
            <div class="counts">
              <%= item.counts.prepared %> prepared &middot;
              <%= item.counts.failed %> failed &middot;
              <%= item.counts.accepted %> approved
            </div>
            <span class="chip <%= view.chip %>"><%= view.label %></span>
          </a>
        <% }); %>
      </div>
    <% } %>

    <p class="footer-note">
      Full internal execution evidence (agent run ledger, runtime evidence) is retained behind Operator and is not exposed here.
    </p>
  </div>
</body>
</html>
