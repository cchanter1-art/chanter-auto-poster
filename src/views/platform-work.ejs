<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Work — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body>
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>

    <div class="breadcrumb"><a href="/platform">Platform</a> / Work</div>
    <h1 class="page-title">Work</h1>
    <p class="page-subtitle">
      All platform work, from every module, in one shared state vocabulary.
    </p>

    <% if (workError) { %>
      <div class="notice notice-error" data-testid="work-error">Work is unavailable right now. &middot; <%= workError %></div>
    <% } %>

    <div class="batch-summary" data-testid="work-summary">
      <div class="stat"><strong><%= workSummary.total %></strong> total</div>
      <div class="stat"><strong><%= workSummary.running %></strong> running</div>
      <div class="stat"><strong><%= workSummary.awaitingApproval %></strong> waiting for approval</div>
      <div class="stat"><strong><%= workSummary.failed %></strong> failed</div>
    </div>

    <% if (items.length === 0) { %>
      <div class="empty-state" data-testid="work-empty">
        <div>No work yet.</div>
        <div class="en">Start one from the <a href="/platform/autoposter">AutoPoster</a> module.</div>
      </div>
    <% } else { %>
      <div class="batch-list" data-testid="work-list">
        <% items.forEach(function (item) { %>
          <% const view = platformStatus.presentation(item.state); %>
          <a class="batch-row" href="<%= item.href %>" data-work="<%= item.workId %>" data-state="<%= item.state %>">
            <div>
              <div><%= item.title %></div>
              <div class="meta">
                <%= item.moduleId === 'autoposter' ? 'AutoPoster' : item.moduleId %>
                &middot; <%= item.stateReason %>
              </div>
            </div>
            <div class="counts">
              <%= item.counts.accepted %>/<%= item.counts.total %> approved
            </div>
            <span class="chip <%= view.chip %>"><%= view.label %></span>
          </a>
        <% }); %>
      </div>
    <% } %>

    <p class="footer-note">
      Actions happen inside the module that owns the work. This page is read-only.
    </p>
  </div>
</body>
</html>
