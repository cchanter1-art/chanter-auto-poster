<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Work — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body class="platform-command-center">
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>
    <main class="command-main">
      <%- include('_platform-page-header', {
        eyebrow: 'Shared work state',
        title: 'Work',
        subtitle: 'Running, waiting, attention, and complete across registered modules.',
        action: commandCenter.modules.find(function (module) { return module.action.enabled; }).action
      }) %>

      <% if (workError) { %>
        <div class="notice notice-error" data-testid="work-error">Work is unavailable. <%= workError %></div>
      <% } %>
      <%- include('_platform-degraded', { workError: workError, workDegraded: locals.workDegraded }) %>

      <div class="batch-summary command-summary" data-testid="work-summary">
        <div class="stat"><strong><%= workSummary.total %></strong> total</div>
        <div class="stat"><strong><%= workSummary.running %></strong> running</div>
        <div class="stat"><strong><%= workSummary.awaitingApproval %></strong> waiting</div>
        <div class="stat"><strong><%= workSummary.failed %></strong> failed</div>
      </div>

      <div class="work-groups" data-testid="work-groups">
        <% commandCenter.workGroups.forEach(function (group) { %>
          <section class="command-section work-group" data-work-group="<%= group.id %>" aria-labelledby="work-group-<%= group.id %>">
            <div class="command-section-heading">
              <h2 id="work-group-<%= group.id %>"><%= group.label %></h2>
              <span class="chip chip-neutral"><%= group.items.length %></span>
            </div>
            <% if (group.items.length === 0) { %>
              <div class="command-empty">No work in this state.</div>
            <% } else { %>
              <div class="batch-list">
                <% group.items.forEach(function (item) { const view = platformStatus.presentation(item.state); %>
                  <%- include('_platform-work-row', {
                    item: item,
                    view: view,
                    metaText: item.stateReason,
                    countsText: `${item.counts.accepted}/${item.counts.total} approved`,
                    chipLabel: view.label
                  }) %>
                  <div
                    class="work-value-summary"
                    data-value-work="<%= item.workId %>"
                    data-value-state="<%= item.valueEvaluation.readiness %>"
                  >
                    <dl>
                      <div><dt>Value state</dt><dd><span class="chip <%= item.valueStateChip %>"><%= item.valueState %></span></dd></div>
                      <div><dt>Missing measurements</dt><dd><%= item.missingMeasurementsCount %></dd></div>
                      <div><dt>Objective</dt><dd><%= item.valueObjective %></dd></div>
                      <div><dt>Verification</dt><dd><%= item.valueVerification %></dd></div>
                    </dl>
                    <% if (item.valueEvidenceHref) { %>
                      <a class="text-action" href="<%= item.valueEvidenceHref %>">View linked evidence</a>
                    <% } else { %>
                      <span class="value-evidence-unavailable">Linked evidence unavailable</span>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </section>
        <% }); %>
      </div>
      <p class="footer-note">This page is read-only. Work changes only inside its owning module.</p>
    </main>
  </div>
</body>
</html>
