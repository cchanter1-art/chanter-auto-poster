<!DOCTYPE html>
<html lang="el">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Compose — CHANTER Platform</title>
  <link rel="stylesheet" href="/platform/platform.css">
</head>
<body>
  <div class="shell">
    <%- include('_platform-nav', { active: locals.active || '' }) %>

    <div class="breadcrumb"><a href="/platform">Platform</a> / Σύνθεση</div>
    <h1 class="page-title">Σύνθεση δημοσίευσης &middot; <span class="en-title">Compose</span></h1>

    <div id="notice" class="notice hidden"></div>

    <% if (selectableCount === 0) { %>
      <div class="empty-state">
        <div>Δεν υπάρχει συνδεδεμένος λογαριασμός έτοιμος για δημοσίευση.</div>
        <div class="en">No connected, publishing-ready account. Connect one from the <a href="/private/autoposter">classic console</a> to begin.</div>
        <% if (accountsError) { %><div class="en"><%= accountsError %></div><% } %>
      </div>
    <% } else { %>
      <ol class="step-rail" id="step-rail">
        <li class="step" data-step="upload"><span class="step-mark">1</span><span class="step-label">Αρχεία</span></li>
        <li class="step" data-step="accounts"><span class="step-mark">2</span><span class="step-label">Λογαριασμοί</span></li>
        <li class="step" data-step="caption"><span class="step-mark">3</span><span class="step-label">Λεζάντα</span></li>
        <li class="step" data-step="schedule"><span class="step-mark">4</span><span class="step-label">Χρόνος</span></li>
        <li class="step" data-step="review"><span class="step-mark">5</span><span class="step-label">Έλεγχος</span></li>
      </ol>

      <div class="panel">
        <form id="compose-form">
          <!-- 1 · Upload -->
          <section class="compose-step" data-section="upload">
            <div class="compose-step-head">
              <h3 class="section-title">1 &middot; Αρχεία</h3>
              <span class="step-state" data-state-for="upload"></span>
            </div>
            <div id="dropzone" class="dropzone">
              <div class="dz-primary">Σύρετε βίντεο ή εικόνες εδώ</div>
              <div class="dz-secondary">MP4, MOV, WebM, JPG, PNG, WebP &middot; έως <%= composeDefaults.maxItems %> αρχεία &middot; 250MB το καθένα</div>
              <input id="file-input" type="file" name="videos" accept="video/mp4,video/quicktime,video/webm,.mp4,.mov,.webm,image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple style="display:none">
            </div>
            <ul id="file-list" class="file-list"></ul>
            <details id="media-url-disclosure" class="advanced-schedule">
              <summary>Ήδη online &middot; Already hosted</summary>
              <label class="field-label" for="publicMediaUrl">Public media URL</label>
              <input id="publicMediaUrl" type="url" placeholder="https://example.com/media.mp4">
              <p class="section-note">Μόνο βίντεο μέσω HTTPS. Χρησιμοποιήστε είτε αρχεία είτε URL. &middot; HTTPS video only; use files or a URL, not both.</p>
            </details>
            <% if (autoMusicConfigured) { %>
              <label class="toggle-row" id="auto-music-row">
                <input type="checkbox" id="auto-music">
                <span>Μουσική υπόκρουση &middot; Auto Music</span>
              </label>
              <p id="auto-music-status" class="section-note" aria-live="polite"></p>
            <% } %>
          </section>

          <!-- 2 · Accounts -->
          <section class="compose-step" data-section="accounts">
            <div class="compose-step-head">
              <h3 class="section-title">2 &middot; Λογαριασμοί</h3>
              <span class="step-state" data-state-for="accounts"></span>
            </div>
            <% if (!capabilities.multiAccountPosting) { %>
              <p class="lock-line">Multiple accounts<span class="lock-reason">Locked by your package</span></p>
            <% } %>
            <div id="destination-list" class="destination-groups">
              <% for (const group of destinationGroups) { %>
                <section class="destination-group" data-provider="<%= group.provider %>">
                  <div class="destination-group-head">
                    <h4 class="destination-group-title"><%= group.providerDisplayName %></h4>
                    <% if (capabilities.multiAccountPosting && group.selectable && group.accounts.length > 1) { %>
                      <button type="button" class="btn btn-quiet select-all-provider" data-provider="<%= group.provider %>">Select all</button>
                    <% } %>
                  </div>
                  <div class="destination-chip-row">
                    <% for (const account of group.accounts) { %>
                      <div class="destination-chip<%= account.selectable ? '' : ' destination-chip-disabled' %>">
                        <label class="destination-chip-main">
                          <input type="<%= capabilities.multiAccountPosting ? 'checkbox' : 'radio' %>"
                                 name="destination" class="destination-checkbox"
                                 value="<%= account.provider %>|<%= account.accountId %>"
                                 data-provider="<%= account.provider %>" data-account-id="<%= account.accountId %>"
                                 <% if (!account.selectable) { %>disabled aria-disabled="true"<% } %>>
                          <span class="destination-provider"><%= account.providerDisplayName %></span>
                          <span class="destination-label"><%= account.label %></span>
                        </label>
                        <% if (!account.selectable && account.unavailableReason) { %>
                          <span class="destination-chip-note"><%= account.unavailableReason %></span>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                </section>
              <% } %>
            </div>
            <div class="destination-actions">
              <span id="selected-count" class="selected-count" aria-live="polite" data-none="No accounts selected"></span>
              <button type="button" id="clear-destinations" class="btn btn-quiet">Clear selection</button>
            </div>
          </section>

          <!-- 3 · Caption -->
          <section class="compose-step" data-section="caption">
            <div class="compose-step-head">
              <h3 class="section-title">3 &middot; Λεζάντα</h3>
              <span class="step-state" data-state-for="caption"></span>
            </div>
            <div class="form-row">
              <div>
                <label class="field-label" for="caption">Λεζάντα &middot; Caption</label>
                <textarea id="caption" rows="3" placeholder="<%= autoCaptionConfigured ? 'Αφήστε το κενό για αυτόματη προετοιμασία' : 'Γράψτε μια λεζάντα' %>"></textarea>
                <p class="section-note" id="auto-caption-note">
                  <% if (autoCaptionConfigured) { %>
                    Κενή λεζάντα σημαίνει Auto Caption ανά βίντεο κατά την προετοιμασία. &middot; Left blank, Auto Caption writes one per video during preparation.
                  <% } else { %>
                    Το Auto Caption δεν είναι ρυθμισμένο. &middot; Auto Caption isn’t configured; write a caption here.
                  <% } %>
                </p>
              </div>
            </div>
            <div class="form-row">
              <div>
                <label class="field-label" for="hashtags">Hashtags</label>
                <input id="hashtags" type="text" placeholder="#chanter #viral">
              </div>
            </div>
            <div class="form-row">
              <div>
                <label class="field-label" for="shared-sound">Ήχος &middot; Sound</label>
                <select id="shared-sound">
                  <option value="keep_original">Αρχικός &middot; Original</option>
                  <option value="mute">Χωρίς ήχο &middot; Muted</option>
                  <option value="tiktok_recommended">Ήχος TikTok &middot; TikTok sound</option>
                </select>
              </div>
            </div>
            <% if (capabilities.perAccountOverrides) { %>
              <label class="toggle-row hidden" id="per-account-toggle-row">
                <input type="checkbox" id="per-account-toggle">
                <span>Διαφοροποίηση ανά λογαριασμό &middot; Per-account variation</span>
              </label>
              <div id="per-account-panel" class="per-account-panel hidden">
                <p class="section-note">Όσα δεν αλλάξετε κληρονομούν την κύρια λεζάντα. &middot; Anything left blank inherits the main caption.</p>
                <div id="per-account-rows"></div>
              </div>
            <% } else { %>
              <p class="lock-line hidden" id="per-account-locked">Διαφοροποίηση ανά λογαριασμό<span class="lock-reason">Κλειδωμένο από το πακέτο σας &middot; Locked by your package</span></p>
            <% } %>
            <!-- Provider-specific metadata. Rendered only when that provider is
                 actually a selected destination — never as standing clutter. -->
            <div id="youtube-fields" class="provider-fields hidden" data-provider-fields="youtube">
              <h4 class="provider-fields-title">YouTube</h4>
              <div class="form-row">
                <div>
                  <label class="field-label" for="youtubeTitle">Τίτλος &middot; Title</label>
                  <input id="youtubeTitle" type="text" maxlength="100" placeholder="Video title">
                  <p class="section-note">Απαιτείται. Δεν αντιγράφεται από τη λεζάντα. &middot; Required; never copied from the caption.</p>
                </div>
              </div>
              <div class="form-row">
                <div>
                  <label class="field-label" for="youtubeDescription">Περιγραφή &middot; Description</label>
                  <textarea id="youtubeDescription" rows="2" maxlength="5000" placeholder="Optional description…"></textarea>
                </div>
              </div>
              <p class="section-note">Ιδιωτικό (κλειδωμένο) &middot; Private (locked), subscriber notifications disabled.</p>
            </div>
            <p id="sound-note" class="section-note hidden" style="color:var(--accent)">
              Ο «Ήχος TikTok» απαιτεί χειροκίνητη ολοκλήρωση στην εφαρμογή TikTok. &middot; “TikTok sound” needs manual completion in the TikTok app.
            </p>
          </section>

          <!-- 4 · Schedule -->
          <section class="compose-step" data-section="schedule">
            <div class="compose-step-head">
              <h3 class="section-title">4 &middot; Χρόνος</h3>
              <span class="step-state" data-state-for="schedule"></span>
            </div>
            <label class="toggle-row">
              <input type="radio" name="when" value="soonest" checked>
              <span>Συντομότερα &middot; Earliest safe slot</span>
            </label>
            <label class="toggle-row">
              <input type="radio" name="when" value="at">
              <span>Προγραμματισμός &middot; Schedule</span>
            </label>
            <div class="form-row cols-2 hidden" id="schedule-at">
              <div>
                <label class="field-label" for="startDate">Ημερομηνία</label>
                <input id="startDate" type="date">
              </div>
              <div>
                <label class="field-label" for="startTime">Ώρα</label>
                <input id="startTime" type="time">
              </div>
            </div>
            <% if (capabilities.advancedScheduling) { %>
              <details id="advanced-schedule" class="advanced-schedule hidden">
                <summary>Για προχωρημένους &middot; Advanced scheduling</summary>

                <!-- Recurring is a scheduling CHOICE, not a mode: the same
                     source set repeated across a bounded run of days. -->
                <label class="toggle-row" id="repeat-daily-row">
                  <input type="checkbox" id="repeat-daily">
                  <span>Επανάληψη κάθε ημέρα &middot; Repeat daily</span>
                </label>
                <div id="recurring-panel" class="hidden">
                  <div class="form-row cols-2">
                    <div>
                      <label class="field-label" for="seriesEndDate">Τελευταία ημέρα &middot; Last day</label>
                      <input id="seriesEndDate" type="date">
                    </div>
                    <div></div>
                  </div>
                  <label class="toggle-row">
                    <input type="checkbox" id="approveSeries">
                    <span>Έγκριση όλης της σειράς τώρα &middot; Approve the whole series now</span>
                  </label>
                  <p class="section-note" id="series-approval-note"></p>
                  <p class="section-note" id="series-preview" aria-live="polite"></p>
                </div>

                <div id="spread-modes">
                <div class="mode-tabs" id="mode-tabs">
                  <button type="button" class="mode-tab active" data-mode="interval">Σειριακά</button>
                  <button type="button" class="mode-tab" data-mode="dateRange">Εύρος ημερών</button>
                  <button type="button" class="mode-tab" data-mode="dailySlots">Ώρες ημέρας</button>
                </div>
                <div class="mode-panel hidden" data-mode-panel="dateRange">
                  <div class="form-row cols-3">
                    <div>
                      <label class="field-label" for="lastDay">Τελευταία ημέρα</label>
                      <input id="lastDay" type="date">
                    </div>
                    <div>
                      <label class="field-label" for="postsPerDay">Ανά ημέρα</label>
                      <input id="postsPerDay" type="number" min="1" max="20" value="1">
                    </div>
                    <div>
                      <label class="field-label" for="dailyEndTime">Έως (προαιρετικό)</label>
                      <input id="dailyEndTime" type="time">
                    </div>
                  </div>
                </div>
                <div class="mode-panel hidden" data-mode-panel="dailySlots">
                  <div class="form-row cols-2">
                    <div>
                      <label class="field-label" for="slotsLastDay">Τελευταία ημέρα</label>
                      <input id="slotsLastDay" type="date">
                    </div>
                    <div></div>
                  </div>
                  <label class="field-label">Ώρες ανά ημέρα</label>
                  <div id="daily-slot-list" class="slot-list"></div>
                  <button type="button" id="add-slot-btn" class="btn btn-quiet">+ Ώρα</button>
                </div>
                </div>
              </details>
            <% } %>
          </section>

          <!-- 5 · Review -->
          <section class="compose-step" data-section="review">
            <div class="compose-step-head">
              <h3 class="section-title">5 &middot; Έλεγχος</h3>
              <span class="step-state" data-state-for="review"></span>
            </div>
            <ul id="review-list" class="review-list" aria-live="polite"></ul>
            <button id="submit-btn" type="submit" class="btn btn-primary" disabled>Προγραμματισμός</button>
            <span id="submit-status" class="item-note" style="margin-left:12px"></span>
            <p class="section-note">Όλα δημιουργούνται ως προσχέδια. Τίποτα δεν δημοσιεύεται χωρίς τη δική σας έγκριση. &middot; Everything is a draft; nothing publishes without your approval.</p>
          </section>
        </form>
      </div>
    <% } %>
  </div>

  <script>
    (function () {
      'use strict';

      var form = document.getElementById('compose-form');
      if (!form) return;

      // Capabilities resolved server-side by the one canonical policy seam
      // (src/composerPolicy.js). This mirrors them for presentation only — the
      // API re-checks every one of them at submit time.
      var CAP = <%- JSON.stringify({
        maxDestinationsPerPost: capabilities.maxDestinationsPerPost,
        multiAccountPosting: capabilities.multiAccountPosting,
        perAccountOverrides: capabilities.perAccountOverrides,
        maxItemsPerDraft: capabilities.maxItemsPerDraft,
        advancedScheduling: capabilities.advancedScheduling
      }) %>;
      var SAFETY_BUFFER_MINUTES = <%= composeDefaults.safetyBufferMinutes %>;
      // Recurrence bounds mirrored from the engine that enforces them, so the
      // preview can never promise a series the server would refuse.
      var MAX_DAILY_OCCURRENCES = <%= composeDefaults.maxDailyOccurrences %>;
      var MAX_RECURRING_JOBS = <%= composeDefaults.maxRecurringJobs %>;
      var SCHEDULING_HORIZON_DAYS = <%- JSON.stringify(composeDefaults.schedulingHorizonDays) %>;

      var dropzone = document.getElementById('dropzone');
      var fileInput = document.getElementById('file-input');
      var fileList = document.getElementById('file-list');
      var submitBtn = document.getElementById('submit-btn');
      var submitStatus = document.getElementById('submit-status');
      var selectedCountEl = document.getElementById('selected-count');
      var reviewList = document.getElementById('review-list');
      var soundNote = document.getElementById('sound-note');
      var sharedSound = document.getElementById('shared-sound');
      var captionEl = document.getElementById('caption');
      var hashtagsEl = document.getElementById('hashtags');
      var perAccountToggle = document.getElementById('per-account-toggle');
      var perAccountToggleRow = document.getElementById('per-account-toggle-row');
      var perAccountPanel = document.getElementById('per-account-panel');
      var perAccountRows = document.getElementById('per-account-rows');
      var perAccountLocked = document.getElementById('per-account-locked');
      var advanced = document.getElementById('advanced-schedule');
      var scheduleAt = document.getElementById('schedule-at');
      var mediaUrlInput = document.getElementById('publicMediaUrl');
      var autoMusicToggle = document.getElementById('auto-music');
      var autoMusicStatus = document.getElementById('auto-music-status');
      var youtubeFields = document.getElementById('youtube-fields');
      var youtubeTitle = document.getElementById('youtubeTitle');
      var youtubeDescription = document.getElementById('youtubeDescription');
      var repeatDaily = document.getElementById('repeat-daily');
      var recurringPanel = document.getElementById('recurring-panel');
      var seriesEndDate = document.getElementById('seriesEndDate');
      var approveSeriesInput = document.getElementById('approveSeries');
      var seriesPreview = document.getElementById('series-preview');
      var seriesApprovalNote = document.getElementById('series-approval-note');
      var spreadModes = document.getElementById('spread-modes');
      var selectedFiles = [];
      var currentMode = 'interval';
      var overrides = {};

      function recurringOn() {
        return Boolean(advanced && advanced.open && repeatDaily && repeatDaily.checked);
      }
      // Auto Music derivatives staged for the exact files they were rendered
      // from. Keyed by name:size so a changed file list can never carry a stale
      // token forward.
      var musicTokens = {};
      var musicPending = false;

      function fileKey(file) { return file.name + ':' + file.size; }
      function mediaUrlValue() { return mediaUrlInput ? mediaUrlInput.value.trim() : ''; }
      function usingUrlSource() { return selectedFiles.length === 0 && mediaUrlValue() !== ''; }
      function youtubeSelected() {
        return selectedDestinations().some(function (dest) { return dest.provider === 'youtube'; });
      }

      function showNotice(message, kind) {
        var el = document.getElementById('notice');
        el.textContent = message;
        el.className = 'notice ' + (kind === 'error' ? 'notice-error' : 'notice-ok');
      }

      function pad(value) { return (value < 10 ? '0' : '') + value; }
      function localDate(date) {
        return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate());
      }
      function localTime(date) { return pad(date.getHours()) + ':' + pad(date.getMinutes()); }

      // The earliest slot acceptance can safely keep in the future, expressed in
      // the user's own local time. The server re-validates it regardless.
      function earliestSafeBase() {
        return new Date(Date.now() + (SAFETY_BUFFER_MINUTES + 2) * 60000);
      }

      var tomorrow = new Date(Date.now() + 86400000);
      document.getElementById('startDate').value = localDate(tomorrow);
      document.getElementById('startTime').value = '10:00';
      if (advanced) {
        document.getElementById('lastDay').value = localDate(tomorrow);
        document.getElementById('slotsLastDay').value = localDate(tomorrow);
        // A one-week series is the smallest useful default; the user changes it.
        if (seriesEndDate) seriesEndDate.value = localDate(new Date(Date.now() + 7 * 86400000));
      }

      // ── 1 · Files ──
      function refreshFileList() {
        fileList.innerHTML = '';
        selectedFiles.forEach(function (file, index) {
          var li = document.createElement('li');
          li.innerHTML = '<span></span><span class="size">' + (file.size / 1048576).toFixed(1) + ' MB</span>';
          li.firstChild.textContent = file.name;
          var remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'btn btn-quiet';
          remove.textContent = '✕';
          remove.addEventListener('click', function () {
            selectedFiles.splice(index, 1);
            refreshFileList();
          });
          li.appendChild(remove);
          fileList.appendChild(li);
        });
        // Drop derivatives whose source is no longer staged, so a removed file
        // can never carry its prepared media into a later submission.
        var live = {};
        selectedFiles.forEach(function (file) {
          var key = fileKey(file);
          if (Object.prototype.hasOwnProperty.call(musicTokens, key)) live[key] = musicTokens[key];
        });
        musicTokens = live;
        update();
        stageMusic();
      }
      function addFiles(files) {
        Array.prototype.slice.call(files).forEach(function (file) {
          if (selectedFiles.length >= CAP.maxItemsPerDraft) return;
          selectedFiles.push(file);
        });
        refreshFileList();
      }
      dropzone.addEventListener('click', function () { fileInput.click(); });
      fileInput.addEventListener('change', function () { addFiles(fileInput.files); fileInput.value = ''; });
      dropzone.addEventListener('dragover', function (event) { event.preventDefault(); dropzone.classList.add('dragover'); });
      dropzone.addEventListener('dragleave', function () { dropzone.classList.remove('dragover'); });
      dropzone.addEventListener('drop', function (event) {
        event.preventDefault();
        dropzone.classList.remove('dragover');
        if (event.dataTransfer && event.dataTransfer.files) addFiles(event.dataTransfer.files);
      });

      // ── 2 · Accounts ──
      // One selection control for one account and for many. When the package
      // locks multi-account posting the same control renders as a radio, so the
      // step never becomes a different product.
      var boxes = Array.prototype.slice.call(document.querySelectorAll('.destination-checkbox'))
        .filter(function (box) { return !box.disabled; });

      function selectedBoxes() {
        return boxes.filter(function (box) { return box.checked; });
      }
      function selectedDestinations() {
        return selectedBoxes().map(function (box) {
          var accountId = box.dataset.accountId;
          var override = overrides[accountId];
          var usingOverrides = CAP.perAccountOverrides && perAccountToggle && perAccountToggle.checked;
          return {
            provider: box.dataset.provider,
            accountId: accountId,
            soundMode: usingOverrides && override && override.soundMode
              ? override.soundMode
              : sharedSound.value
          };
        });
      }

      boxes.forEach(function (box) {
        box.addEventListener('change', function () {
          if (box.checked && selectedBoxes().length > CAP.maxDestinationsPerPost) {
            box.checked = false;
            showNotice(CAP.multiAccountPosting
              ? 'Up to ' + CAP.maxDestinationsPerPost + ' destinations per post.'
              : 'Multiple accounts are locked by your package.', 'error');
          }
          update();
        });
      });
      Array.prototype.slice.call(document.querySelectorAll('.select-all-provider')).forEach(function (button) {
        button.addEventListener('click', function () {
          var reached = false;
          boxes.forEach(function (box) {
            if (box.dataset.provider !== button.dataset.provider || box.checked) return;
            if (selectedBoxes().length >= CAP.maxDestinationsPerPost) { reached = true; return; }
            box.checked = true;
          });
          if (reached) showNotice('Up to ' + CAP.maxDestinationsPerPost + ' destinations per post.', 'error');
          update();
        });
      });
      document.getElementById('clear-destinations').addEventListener('click', function () {
        boxes.forEach(function (box) { box.checked = false; });
        update();
      });

      // Default safely when exactly one valid account exists.
      if (boxes.length === 1) boxes[0].checked = true;

      // ── Auto Music ──
      // Uses the SAME preparation endpoint the classic intake used
      // (POST /api/auto-caption with autoMusic=1): one signed token per file,
      // redeemed at submit. Failure is never fatal — the original video is used
      // and the composer says so rather than silently dropping the request.
      if (mediaUrlInput) mediaUrlInput.addEventListener('input', update);
      if (autoMusicToggle) {
        autoMusicToggle.addEventListener('change', function () {
          musicTokens = {};
          if (autoMusicToggle.checked) stageMusic();
          else { autoMusicStatus.textContent = ''; update(); }
        });
      }

      function stageMusic() {
        if (!autoMusicToggle || !autoMusicToggle.checked) return;
        var pending = selectedFiles.filter(function (file) {
          return !Object.prototype.hasOwnProperty.call(musicTokens, fileKey(file));
        });
        if (pending.length === 0) { update(); return; }
        musicPending = true;
        autoMusicStatus.innerHTML = '<span class="spin"></span> Προετοιμασία μουσικής…';
        update();

        Promise.all(pending.map(function (file) {
          var body = new FormData();
          body.append('video', file);
          body.append('autoMusic', '1');
          body.append('caption', captionEl.value);
          body.append('hashtags', hashtagsEl.value);
          return fetch('/api/auto-caption', { method: 'POST', body: body, headers: { 'Accept': 'application/json' } })
            .then(function (response) { return response.json(); })
            .then(function (payload) {
              var token = payload && payload.music && payload.music.token;
              musicTokens[fileKey(file)] = token || '';
              return Boolean(token);
            })
            .catch(function () { musicTokens[fileKey(file)] = ''; return false; });
        })).then(function (results) {
          musicPending = false;
          var ok = results.filter(Boolean).length;
          autoMusicStatus.textContent = ok === results.length
            ? ok + (ok === 1 ? ' βίντεο με μουσική' : ' βίντεο με μουσική')
            : ok + '/' + results.length + ' με μουσική· τα υπόλοιπα κρατούν τον αρχικό ήχο.';
          update();
        });
      }

      function stagedTokens() {
        if (!autoMusicToggle || !autoMusicToggle.checked) return [];
        return selectedFiles
          .map(function (file) { return musicTokens[fileKey(file)]; })
          .filter(function (token) { return Boolean(token); });
      }

      // ── 3 · Caption ──
      sharedSound.addEventListener('change', update);
      captionEl.addEventListener('input', update);
      if (youtubeTitle) youtubeTitle.addEventListener('input', update);
      if (perAccountToggle) {
        perAccountToggle.addEventListener('change', function () {
          perAccountPanel.classList.toggle('hidden', !perAccountToggle.checked);
          renderOverrideRows();
          update();
        });
      }

      // Only the SELECTED accounts get an override row, and only the fields that
      // actually vary — never a duplicate of the whole caption form.
      function renderOverrideRows() {
        if (!perAccountRows || !perAccountToggle || !perAccountToggle.checked) return;
        perAccountRows.innerHTML = '';
        selectedBoxes().forEach(function (box) {
          var accountId = box.dataset.accountId;
          var label = box.parentNode.querySelector('.destination-label');
          var row = document.createElement('div');
          row.className = 'per-account-row';
          var name = document.createElement('span');
          name.className = 'per-account-name';
          name.textContent = label ? label.textContent : accountId;
          var select = document.createElement('select');
          [['', 'Κληρονομεί · Inherit'], ['keep_original', 'Αρχικός'], ['mute', 'Χωρίς ήχο'], ['tiktok_recommended', 'Ήχος TikTok']]
            .forEach(function (pair) {
              var option = document.createElement('option');
              option.value = pair[0];
              option.textContent = pair[1];
              select.appendChild(option);
            });
          select.value = (overrides[accountId] && overrides[accountId].soundMode) || '';
          select.addEventListener('change', function () {
            overrides[accountId] = overrides[accountId] || {};
            overrides[accountId].soundMode = select.value;
            update();
          });
          row.appendChild(name);
          row.appendChild(select);
          perAccountRows.appendChild(row);
        });
      }

      // ── 4 · Schedule ──
      Array.prototype.slice.call(document.querySelectorAll('input[name="when"]')).forEach(function (radio) {
        radio.addEventListener('change', function () {
          scheduleAt.classList.toggle('hidden', currentWhen() !== 'at');
          update();
        });
      });
      function currentWhen() {
        var checked = document.querySelector('input[name="when"]:checked');
        return checked ? checked.value : 'soonest';
      }
      if (advanced) {
        Array.prototype.slice.call(document.querySelectorAll('.mode-tab')).forEach(function (tab) {
          tab.addEventListener('click', function () {
            currentMode = tab.dataset.mode;
            Array.prototype.slice.call(document.querySelectorAll('.mode-tab')).forEach(function (other) {
              other.classList.toggle('active', other === tab);
            });
            Array.prototype.slice.call(document.querySelectorAll('.mode-panel')).forEach(function (panel) {
              panel.classList.toggle('hidden', panel.dataset.modePanel !== currentMode);
            });
            update();
          });
        });
        var slotList = document.getElementById('daily-slot-list');
        function addSlotRow(value) {
          var row = document.createElement('div');
          row.className = 'slot-row';
          row.innerHTML = '<input type="time" class="slot-time" value="' + (value || '10:00') + '">' +
            '<button type="button" class="btn btn-quiet slot-remove">✕</button>';
          row.querySelector('.slot-time').addEventListener('input', update);
          row.querySelector('.slot-remove').addEventListener('click', function () {
            if (slotList.children.length <= 1) return;
            row.remove();
            update();
          });
          slotList.appendChild(row);
        }
        addSlotRow('10:00');
        document.getElementById('add-slot-btn').addEventListener('click', function () { addSlotRow(); update(); });
      }
      // ── Recurring daily ──
      // A series needs a definite first release, so enabling it selects the
      // explicit Schedule option rather than the "earliest safe slot" default.
      if (repeatDaily) {
        repeatDaily.addEventListener('change', function () {
          recurringPanel.classList.toggle('hidden', !repeatDaily.checked);
          if (repeatDaily.checked) {
            var at = document.querySelector('input[name="when"][value="at"]');
            if (at) { at.checked = true; scheduleAt.classList.remove('hidden'); }
          }
          update();
        });
        [seriesEndDate, approveSeriesInput].forEach(function (el) {
          if (el) el.addEventListener('change', update);
        });
      }

      function daysInclusive(startStr, endStr) {
        var start = Date.parse(startStr + 'T00:00:00Z');
        var end = Date.parse(endStr + 'T00:00:00Z');
        if (!Number.isFinite(start) || !Number.isFinite(end) || end < start) return null;
        return Math.floor((end - start) / 86400000) + 1;
      }

      // Mirrors maxScheduler.computeDailySchedulePlan's own arithmetic for a
      // live preview only; the server stays authoritative at submit time.
      function seriesShape() {
        var startStr = document.getElementById('startDate').value;
        var endStr = seriesEndDate ? seriesEndDate.value : '';
        var occurrences = (startStr && endStr) ? daysInclusive(startStr, endStr) : null;
        if (!occurrences) return { ok: false, reason: 'Ορίστε πρώτη και τελευταία ημέρα' };
        if (occurrences > MAX_DAILY_OCCURRENCES) {
          return { ok: false, reason: 'Έως ' + MAX_DAILY_OCCURRENCES + ' ημέρες' };
        }
        if (SCHEDULING_HORIZON_DAYS !== null && occurrences > SCHEDULING_HORIZON_DAYS) {
          return { ok: false, reason: 'Το πακέτο σας φτάνει ' + SCHEDULING_HORIZON_DAYS + ' ημέρες μπροστά' };
        }
        var sources = selectedFiles.length > 0 ? selectedFiles.length : (usingUrlSource() ? 1 : 0);
        var accounts = selectedDestinations().length;
        var jobs = occurrences * accounts * sources;
        if (accounts > 0 && sources > 0 && jobs > MAX_RECURRING_JOBS) {
          return { ok: false, reason: 'Έως ' + MAX_RECURRING_JOBS + ' δημοσιεύσεις ανά σειρά (' + jobs + ')' };
        }
        return { ok: true, occurrences: occurrences, jobs: jobs, startDate: startStr, endDate: endStr };
      }

      function dailySlotValues() {
        if (!advanced) return [];
        return Array.prototype.slice.call(document.querySelectorAll('.slot-time'))
          .map(function (input) { return input.value; })
          .filter(function (value) { return /^\d{2}:\d{2}$/.test(value); });
      }

      // ── 5 · Review ──
      function scheduleSummary() {
        if (recurringOn()) {
          var shape = seriesShape();
          if (!shape.ok) return '';
          var time = document.getElementById('startTime').value;
          return 'Καθημερινά ' + shape.startDate + ' → ' + shape.endDate + ' · ' + time;
        }
        if (advanced && advanced.open && currentMode === 'dateRange') return 'Κατανομή σε ημέρες';
        if (advanced && advanced.open && currentMode === 'dailySlots') return 'Καθορισμένες ώρες';
        if (currentWhen() === 'soonest') {
          var base = earliestSafeBase();
          return 'Συντομότερα · ' + localTime(base);
        }
        var date = document.getElementById('startDate').value;
        var time = document.getElementById('startTime').value;
        return date && time ? (date + ' ' + time) : '';
      }

      function setStep(step, done, text) {
        var rail = document.querySelector('.step[data-step="' + step + '"]');
        if (rail) rail.classList.toggle('step-done', done);
        var state = document.querySelector('[data-state-for="' + step + '"]');
        if (state) {
          state.textContent = text || '';
          state.classList.toggle('step-state-done', done);
        }
        return done;
      }

      function update() {
        var files = selectedFiles.length;
        var destinations = selectedDestinations();
        var when = scheduleSummary();
        var urlSource = usingUrlSource();
        var sourceCount = files > 0 ? files : (urlSource ? 1 : 0);
        var wantsYouTube = youtubeSelected();

        // Provider metadata appears only when that provider is a destination.
        if (youtubeFields) youtubeFields.classList.toggle('hidden', !wantsYouTube);
        // Auto Music mixes an uploaded video; a hosted URL is used as-is.
        if (document.getElementById('auto-music-row')) {
          document.getElementById('auto-music-row').classList.toggle('hidden', files === 0);
        }

        if (selectedCountEl) {
          selectedCountEl.textContent = destinations.length === 0
            ? selectedCountEl.dataset.none
            : (destinations.length === 1 ? '1 account selected' : destinations.length + ' accounts selected');
          selectedCountEl.classList.toggle('selected-count-active', destinations.length > 0);
        }

        // Per-account variation is only meaningful past one destination, and the
        // locked line only earns its space once the user could have used it.
        if (perAccountToggleRow) perAccountToggleRow.classList.toggle('hidden', destinations.length < 2);
        if (perAccountLocked) perAccountLocked.classList.toggle('hidden', destinations.length < 2);
        if (perAccountToggle && perAccountToggle.checked) renderOverrideRows();
        // Advanced scheduling is reachable as soon as there is anything to
        // schedule: recurring is meaningful with a single source, while the
        // multi-day spread modes only make sense past one.
        if (advanced) advanced.classList.toggle('hidden', sourceCount < 1);
        if (spreadModes) spreadModes.classList.toggle('hidden', sourceCount < 2 || recurringOn());
        if (recurringPanel) recurringPanel.classList.toggle('hidden', !repeatDaily || !repeatDaily.checked);

        if (soundNote) {
          soundNote.classList.toggle('hidden', !destinations.some(function (dest) {
            return dest.soundMode === 'tiktok_recommended';
          }));
        }

        // One YouTube title cannot describe several videos — the same rule the
        // server enforces, surfaced before the user can hit it.
        var youtubeTitleOk = !wantsYouTube || Boolean(youtubeTitle && youtubeTitle.value.trim());
        var youtubeSourceOk = !wantsYouTube || sourceCount === 1;

        // Recurring: every occurrence reuses one caption, and YouTube cannot be
        // a recurring destination because each upload needs its own title.
        var series = recurringOn() ? seriesShape() : null;
        var recurringCaptionOk = !series || Boolean(captionEl.value.trim());
        var recurringProviderOk = !series || !wantsYouTube;
        var recurringOk = !series || (series.ok && recurringCaptionOk && recurringProviderOk);

        if (series && seriesApprovalNote) {
          // Accurate to repository behaviour: approveSeries approves every
          // generated draft at creation. It is not a pre-authorisation of
          // anything that does not exist yet.
          seriesApprovalNote.textContent = approveSeriesInput && approveSeriesInput.checked
            ? 'Και οι ' + (series.ok ? series.jobs : 0) + ' δημοσιεύσεις εγκρίνονται τώρα. · All generated drafts are approved at creation.'
            : 'Κάθε δημοσίευση μένει προσχέδιο μέχρι να την εγκρίνετε. · Every occurrence stays a draft until you approve it.';
        }
        if (series && seriesPreview) {
          seriesPreview.textContent = series.ok
            ? series.occurrences + ' ημέρες × ' + destinations.length + ' λογαριασμοί × ' + sourceCount
              + ' = ' + series.jobs + ' δημοσιεύσεις'
            : series.reason;
          seriesPreview.style.color = series.ok ? '' : 'var(--danger)';
        }

        var uploadOk = setStep('upload', sourceCount > 0,
          urlSource ? 'URL' : (files > 0 ? files + ' αρχεία' : ''));
        var accountsOk = setStep('accounts', destinations.length > 0,
          destinations.length > 0 ? String(destinations.length) : '');
        var captionOk = setStep('caption', youtubeTitleOk && recurringCaptionOk,
          wantsYouTube && !youtubeTitleOk
            ? 'Λείπει τίτλος'
            : (!recurringCaptionOk
                ? 'Απαιτείται για σειρά'
                : (captionEl.value.trim() ? 'Καθορισμένη' : 'Αυτόματη')));
        var scheduleOk = setStep('schedule', Boolean(when) && recurringOk, when);
        var ready = uploadOk && accountsOk && captionOk && scheduleOk
          && youtubeSourceOk && recurringOk && !musicPending;
        setStep('review', ready, ready ? 'Έτοιμο' : '');

        var rows = [
          [uploadOk, urlSource
            ? 'Media URL'
            : (files ? files + (files === 1 ? ' αρχείο' : ' αρχεία') : 'Προσθέστε αρχεία ή URL')],
          [accountsOk, destinations.length
            ? destinations.length + (destinations.length === 1 ? ' λογαριασμός' : ' λογαριασμοί')
            : 'Επιλέξτε λογαριασμό'],
          [captionOk, wantsYouTube && !youtubeTitleOk
            ? 'Απαιτείται τίτλος YouTube'
            : (!recurringCaptionOk
                ? 'Η σειρά χρειάζεται μία λεζάντα'
                : (captionEl.value.trim() ? 'Λεζάντα έτοιμη' : 'Λεζάντα: αυτόματη προετοιμασία'))],
          [scheduleOk, when || (series && !series.ok ? series.reason : 'Ορίστε χρόνο')]
        ];
        // A series states exactly what will be created before Accept: how many
        // occurrences, over which dates, in which timezone, and whether a human
        // still has to approve them.
        if (series) {
          rows.push([series.ok, series.ok
            ? series.occurrences + ' εμφανίσεις · ' + series.jobs + ' δημοσιεύσεις'
            : series.reason]);
          rows.push([recurringProviderOk, recurringProviderOk
            ? (approveSeriesInput && approveSeriesInput.checked
                ? 'Εγκρίνεται όλη η σειρά τώρα'
                : 'Κάθε δημοσίευση χρειάζεται έγκριση')
            : 'Το YouTube δεν μπορεί να είναι επαναλαμβανόμενος προορισμός']);
          rows.push([true, 'Ζώνη ώρας: ' + (Intl.DateTimeFormat().resolvedOptions().timeZone || 'local')]);
        }
        rows.push([ready, ready
          ? 'Έτοιμο'
          : (!youtubeSourceOk
              ? 'Το YouTube δέχεται ένα βίντεο τη φορά'
              : (musicPending ? 'Προετοιμασία μουσικής…' : 'Δεν είναι έτοιμο'))]);

        reviewList.innerHTML = '';
        rows.forEach(function (entry) {
          var li = document.createElement('li');
          li.className = entry[0] ? 'review-ok' : 'review-todo';
          li.textContent = (entry[0] ? '✔ ' : '· ') + entry[1];
          reviewList.appendChild(li);
        });

        submitBtn.disabled = !ready;
      }
      update();

      // ── 6 · Accept ──
      // One identity per page lifetime: repeated submission reuses the same
      // accepted command instead of creating a second one.
      var composerIntakeKey = (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : String(Date.now());
      var composerRequestedAt = new Date().toISOString();
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var destinations = selectedDestinations();
        if ((selectedFiles.length === 0 && !usingUrlSource()) || destinations.length === 0) return;
        submitBtn.disabled = true;
        submitStatus.innerHTML = '<span class="spin"></span> Μεταφόρτωση…';

        var data = new FormData();
        selectedFiles.forEach(function (file) { data.append('videos', file); });
        if (usingUrlSource()) data.append('publicMediaUrl', mediaUrlValue());
        data.append('destinations', JSON.stringify(destinations));
        data.append('caption', captionEl.value);
        data.append('hashtags', hashtagsEl.value);
        var tokens = stagedTokens();
        if (tokens.length > 0) data.append('autoMusicTokens', JSON.stringify(tokens));
        if (youtubeSelected()) {
          data.append('youtubeTitle', youtubeTitle.value);
          data.append('youtubeDescription', youtubeDescription.value);
        }
        data.append('timezoneName', (Intl.DateTimeFormat().resolvedOptions().timeZone || ''));
        data.append('timezoneOffsetMinutes', String(new Date().getTimezoneOffset()));
        data.append('intakeKey', composerIntakeKey);
        data.append('requestedAt', composerRequestedAt);

        var usingAdvanced = advanced && advanced.open && currentMode !== 'interval';
        if (recurringOn()) {
          // One source set, one caption, repeated daily between two dates. The
          // server expands the occurrences through the existing engine.
          data.append('scheduleMode', 'recurringDaily');
          data.append('startDate', document.getElementById('startDate').value);
          data.append('startTime', document.getElementById('startTime').value);
          data.append('endDate', seriesEndDate.value);
          if (approveSeriesInput && approveSeriesInput.checked) data.append('approveSeries', '1');
        } else if (usingAdvanced && currentMode === 'dateRange') {
          data.append('scheduleMode', 'dateRange');
          data.append('firstDay', localDate(earliestSafeBase()));
          data.append('lastDay', document.getElementById('lastDay').value);
          data.append('postsPerDay', document.getElementById('postsPerDay').value);
          data.append('dailyStartTime', currentWhen() === 'at'
            ? document.getElementById('startTime').value
            : localTime(earliestSafeBase()));
          data.append('dailyEndTime', document.getElementById('dailyEndTime').value);
        } else if (usingAdvanced && currentMode === 'dailySlots') {
          data.append('scheduleMode', 'dailySlots');
          data.append('firstDay', localDate(earliestSafeBase()));
          data.append('lastDay', document.getElementById('slotsLastDay').value);
          data.append('dailySlots', JSON.stringify(dailySlotValues()));
        } else {
          // The one default path: ONE base time. Spacing between releases is the
          // server's business (config.batchIntake.staggerDefaultMinutes) and is
          // never asked of the user.
          var base = currentWhen() === 'soonest' ? earliestSafeBase() : null;
          data.append('scheduleMode', 'interval');
          data.append('startDate', base ? localDate(base) : document.getElementById('startDate').value);
          data.append('startTime', base ? localTime(base) : document.getElementById('startTime').value);
        }

        fetch('/api/platform/batches', { method: 'POST', body: data, headers: { 'Accept': 'application/json' } })
          .then(function (response) { return response.json(); })
          .then(function (payload) {
            if (payload && payload.ok && payload.command && payload.command.commandId) {
              submitStatus.textContent = 'Accepted Â· Awaiting approval';
              window.location.href = '/platform/compose/commands/'
                + encodeURIComponent(payload.command.commandId);
              return;
            }
            if (payload && payload.ok && payload.batch) {
              window.location.href = '/platform/compose/' + encodeURIComponent(payload.batch.batchId);
              return;
            }
            // A series has no batch to review: its occurrences are ordinary
            // queue jobs, so it lands on Work where the series is projected.
            if (payload && payload.ok && payload.series) {
              window.location.href = '/platform/work';
              return;
            }
            submitBtn.disabled = false;
            submitStatus.textContent = '';
            showNotice((payload && payload.reason) || 'Η δημιουργία απέτυχε. Δοκιμάστε ξανά.', 'error');
          })
          .catch(function () {
            submitBtn.disabled = false;
            submitStatus.textContent = '';
            showNotice('Η μεταφόρτωση διακόπηκε. Ελέγξτε τη σύνδεση και δοκιμάστε ξανά.', 'error');
          });
      });
    })();
  </script>
</body>
</html>
